<!DOCTYPE HTML>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>360度パノラマビューアー</title>
    <!-- PannellumのCSSとJavaScriptを読み込む -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.css"/>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.js"></script>
    <style>
        /* 画面いっぱいに表示するための設定 */
        body { margin: 0; padding: 0; overflow: hidden; }
        #panorama { width: 100vw; height: 100vh; }
    </style>
</head>
<body>

<div id="panorama"></div>

<script>
    // Pannellumを使ってパノラマ画像を表示する設定
    pannellum.viewer('panorama', {
        "type": "equirectangular", // 画像の形式
        "panorama": "Gemini_Generated_Image_e4on67e4on67e4on.jpg", // 読み込む画像ファイル名
        "autoLoad": true,          // 自動的に読み込みを開始する
        "compass": false           // 必要に応じてコンパスを表示可能
    });
</script>

</body>
</html>